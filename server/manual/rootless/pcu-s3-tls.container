[Unit]
After=pcu-garage.service
[Container]
Image=docker.io/library/nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
ContainerName=pcu-s3-tls
Network=pcu-app.network:ip=10.89.40.30
Network=pcu-storage.network:ip=10.89.41.30
NetworkAlias=s3.internal.pcu.test
Volume=/srv/pcu/config/s3-tls.conf:/etc/nginx/conf.d/default.conf:ro,z
Volume=/srv/pcu/config/tls/internal:/etc/pcu/tls:ro,z
[Service]
Restart=always
[Install]
WantedBy=default.target
