[Unit]
Description=Graduation project gp-worker-image
After=gp-api.service

[Container]
Image=REPLACE_WITH_API_IMAGE_AT_SHA256_DIGEST
ContainerName=gp-worker-image
Pod=graduationproject.pod
StartWithPod=false
EnvironmentFile=/srv/pcu/config/app.env
Environment=NODE_ENV=production

Volume=/srv/pcu/config/ca.crt:/etc/pcu/ca.crt:ro,z
Tmpfs=/tmp:rw,noexec,nosuid,size=512m
Entrypoint=node
Exec=dist/image-worker.js
StopTimeout=120

[Service]
TimeoutStopSec=135
Restart=always

[Install]
WantedBy=default.target
