[Unit]
Description=PCU external TLS termination
After=network-online.target
[Container]
Image=docker.io/library/nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
ContainerName=pcu-edge
Network=host
Volume=/srv/pcu/config/tls-proxy.conf:/etc/nginx/conf.d/default.conf:ro,z
Volume=/srv/pcu/config/tls/public:/etc/pcu/tls:ro,z
[Service]
Restart=always
[Install]
WantedBy=multi-user.target
