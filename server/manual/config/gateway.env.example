NGINX_LISTEN_PORT=8080
# Explicit Aardvark DNS address for pcu-app.network; change with its subnet.
NGINX_RESOLVER=10.89.40.1
NGINX_ENVSUBST_FILTER=^(NGINX_LISTEN_PORT|NGINX_RESOLVER|FILE_GATEWAY_|GARAGE_|S3_BUCKET_|PUBLIC_CORS_|WEB_PUBLIC_ORIGIN|UPLOAD_PART_|PROTECTED_DOWNLOAD_)
FILE_GATEWAY_API_UPSTREAM=http://10.89.40.10:4000
FILE_GATEWAY_TLS_SERVER_NAME=
FILE_GATEWAY_SECRET=REPLACE_WITH_DISTINCT_GATEWAY_SECRET_AT_LEAST_32_CHARACTERS
GARAGE_S3_UPSTREAM=http://10.89.41.10:3900
GARAGE_S3_TLS_SERVER_NAME=garage
GARAGE_PUBLIC_WEB_UPSTREAM=http://10.89.41.10:3902
GARAGE_PUBLIC_WEB_TLS_SERVER_NAME=garage
GARAGE_PUBLIC_BUCKET_HOST=pcu-public.web.garage.localhost
S3_BUCKET_PUBLIC=pcu-public
S3_BUCKET_PROTECTED=pcu-protected
PUBLIC_CORS_ORIGIN_PRIMARY=https://web.pcu.test
PUBLIC_CORS_ORIGIN_SECONDARY=https://api.pcu.test
WEB_PUBLIC_ORIGIN=https://web.pcu.test
UPLOAD_PART_MAX_BYTES=16m
UPLOAD_PART_GLOBAL_CONNECTIONS=512
UPLOAD_PART_PER_IP_CONNECTIONS=128
PROTECTED_DOWNLOAD_GLOBAL_CONNECTIONS=512
PROTECTED_DOWNLOAD_PER_IP_CONNECTIONS=128
