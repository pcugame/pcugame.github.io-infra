NODE_ENV=production
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://pcu:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/pcu?schema=public
SESSION_SECRET=REPLACE_WITH_UNIQUE_SESSION_SECRET_AT_LEAST_32_CHARACTERS
FILE_GATEWAY_SECRET=REPLACE_WITH_DISTINCT_GATEWAY_SECRET_AT_LEAST_32_CHARACTERS
SESSION_COOKIE_NAME=sid
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
GOOGLE_CLIENT_IDS=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
ALLOWED_GOOGLE_HD=pcu.ac.kr
DEV_AUTH_ENABLED=false
CORS_ALLOWED_ORIGINS=https://web.pcu.test
API_PUBLIC_URL=https://api.pcu.test
WEB_PUBLIC_URL=https://web.pcu.test
PUBLIC_ASSET_ORIGIN=https://assets.pcu.test
S3_ENDPOINT=https://s3.internal.pcu.test
S3_PUBLIC_SIGNING_ENDPOINT=https://upload.pcu.test
S3_PROTECTED_DOWNLOAD_SIGNING_ENDPOINT=https://download.pcu.test
S3_REGION=garage
S3_ACCESS_KEY_ID=REPLACE_WITH_GARAGE_APP_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_GARAGE_APP_SECRET
S3_BUCKET_PUBLIC=pcu-public
S3_BUCKET_PROTECTED=pcu-protected
S3_FORCE_PATH_STYLE=true
NODE_EXTRA_CA_CERTS=/etc/pcu/ca.crt
# Start with false. Observe the real proxy peer, then set exact trusted IPs.
TRUST_PROXY=false
WEBGL_PLAY_ENABLED=true
WEBGL_EXTERNAL_CONNECTIONS_ENABLED=false
DIRECT_UPLOAD_WORKER_TEMP_ROOT=/tmp/pcu-direct-upload
DIRECT_UPLOAD_WORKER_TEMP_MAX_MB=6144
VIDEO_WORKER_TEMP_ROOT=/tmp/pcu-video-worker
VIDEO_WORKER_TEMP_DISK_MB=2048
IMAGE_WORKER_TEMP_ROOT=/tmp/pcu-image-worker
IMAGE_WORKER_TEMP_MAX_MB=512
NAS_EXPORT_ROOT=/exports
