{
  "CORSRules": [
    {
      "AllowedOrigins": [
        "https://web.pcu.test"
      ],
      "AllowedMethods": [
        "PUT",
        "HEAD"
      ],
      "AllowedHeaders": [
        "content-type",
        "x-amz-content-sha256",
        "x-amz-date",
        "x-amz-security-token",
        "x-amz-user-agent",
        "x-amz-checksum-crc32",
        "x-amz-checksum-crc32c",
        "x-amz-checksum-sha1",
        "x-amz-checksum-sha256"
      ],
      "ExposeHeaders": [
        "ETag"
      ],
      "MaxAgeSeconds": 300
    }
  ]
}
