# Copy to /srv/graduationproject_v2/.env on the server. Do not commit real values.

# Runtime binding used by server/deploy.sh
API_BIND_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
# The production API is reachable through exactly one loopback nginx proxy hop.
# Set this to false if the API is ever exposed directly without that proxy.
TRUST_PROXY=1

# PostgreSQL container and API DATABASE_URL
POSTGRES_DB=pcu_graduationproject_v2
POSTGRES_USER=pcu_admin
POSTGRES_PASSWORD=replace-with-production-postgres-password
DATABASE_URL=postgresql://pcu_admin:replace-with-production-postgres-password@postgres:5432/pcu_graduationproject_v2?schema=public

# Session cookie
SESSION_SECRET=replace-with-32-plus-character-production-session-secret
SESSION_COOKIE_NAME=sid
SESSION_IDLE_MS=7200000
SESSION_ABSOLUTE_MS=1209600000
SESSION_TOUCH_MIN_INTERVAL_MS=300000
SHUTDOWN_DRAIN_MS=15000
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# OAuth and public origins
GOOGLE_CLIENT_IDS=replace-with-google-web-client-id.apps.googleusercontent.com
ALLOWED_GOOGLE_HD=g.pcu.ac.kr
CORS_ALLOWED_ORIGINS=https://pcugame.github.io
API_PUBLIC_URL=https://replace-with-api-host
WEB_PUBLIC_URL=https://pcugame.github.io
# Browser-visible ordinary public nginx origin rooted at S3_BUCKET_PUBLIC.
# server/deploy.sh starts the byte-preserving proxy; the external TLS proxy/DNS
# must forward this hostname to PUBLIC_ORIGIN_BIND_HOST:PUBLIC_ORIGIN_PORT.
PUBLIC_ASSET_BASE_URL=https://replace-with-public-asset-host
# Values rendered into apps/db/public-origin.nginx.conf.template. Garage must
# have this public hostname as the public bucket name/alias so Host is preserved.
PUBLIC_CORS_ORIGIN_PRIMARY=https://pcugame.github.io
PUBLIC_CORS_ORIGIN_SECONDARY=https://www.pcugame.example
WEB_PUBLIC_ORIGIN=https://pcugame.github.io

# Legacy local storage mount paths used by migration/export compatibility paths
STORAGE_HOST_PATH=/srv/graduationproject_v2/storage

# S3-compatible object storage. The internal hostname must be reachable from
# the API container. The public signing hostname is the external TLS endpoint
# forwarding to the UploadPart nginx started by server/deploy.sh.
S3_INTERNAL_ENDPOINT=https://replace-with-internal-s3-endpoint
S3_PUBLIC_SIGNING_ENDPOINT=https://replace-with-upload-part-host
# Deprecated alias for un-migrated external workers only:
# S3_ENDPOINT=https://replace-with-internal-s3-endpoint
S3_REGION=garage
S3_ACCESS_KEY_ID=replace-with-s3-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
# Optional process-separated credential seam. When set, only the validation
# worker receives these credentials; scope them to protected read and public
# deployment writes (plus the cleanup permissions required by this deployment).
VALIDATION_S3_ACCESS_KEY_ID=replace-with-validation-worker-access-key-id
VALIDATION_S3_SECRET_ACCESS_KEY=replace-with-validation-worker-secret-access-key
# Read-only public/protected credentials scoped to the NAS export worker.
EXPORT_S3_ACCESS_KEY_ID=replace-with-export-worker-access-key-id
EXPORT_S3_SECRET_ACCESS_KEY=replace-with-export-worker-secret-access-key
S3_BUCKET_STAGING=pcu-staging
S3_BUCKET_PUBLIC=pcu-public
S3_BUCKET_PROTECTED=pcu-protected
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SEC=60
# Garage RPC/admin CLI configuration mounted read-only only into the scheduled
# incomplete-multipart safety-net job. Keep retention longer than the maximum
# API session expiry; exact DB abort tasks remain the primary cleanup path.
GARAGE_MAINTENANCE_CONFIG_HOST_PATH=/etc/garage/garage.toml
GARAGE_MAINTENANCE_IMAGE=dxflrs/garage:v1.1.0
INCOMPLETE_MULTIPART_MAX_AGE=2d
UPLOAD_PART_URL_TTL_SEC=300
UPLOAD_PART_URL_BATCH_MAX=16
UPLOAD_PART_URL_REFRESH_MAX=64
UPLOAD_PART_URL_REFRESH_WINDOW_MS=300000
DIRECT_UPLOAD_ACTOR_ACTIVE_SESSION_MAX=4
DIRECT_UPLOAD_PROJECT_ACTIVE_SESSION_MAX=2
DIRECT_UPLOAD_ACTOR_OUTSTANDING_MAX_BYTES=10737418240
RATE_LIMIT_DIRECT_SESSION_CREATE_MAX=12
RATE_LIMIT_DIRECT_SESSION_CREATE_WINDOW_MS=3600000
RATE_LIMIT_DIRECT_PART_URL_MAX=120
RATE_LIMIT_DIRECT_PART_URL_WINDOW_MS=60000
UPLOAD_CHUNK_SIZE_MB=10
# Optional assertion only. deploy.sh derives the nginx limit from
# UPLOAD_CHUNK_SIZE_MB and fails closed if this value differs, preventing both
# late storage exhaustion and an accidentally-too-small proxy cap.
UPLOAD_PART_MAX_BYTES=10m
INLINE_UPLOAD_MAX_BYTES=16777216
# Used by Garage's standard PutBucketCors initialization, not Fastify CORS.
S3_CORS_ALLOWED_ORIGINS=https://pcugame.github.io

# Production ordinary nginx data planes. Bind them to loopback when the host's
# existing TLS reverse proxy owns the public sockets. Upstream URLs must be
# root origins without credentials, paths, query strings, or fragments.
UPLOAD_PART_PROXY_BIND_HOST=127.0.0.1
UPLOAD_PART_PROXY_PORT=3901
PUBLIC_ORIGIN_BIND_HOST=127.0.0.1
PUBLIC_ORIGIN_PORT=3904
GARAGE_S3_UPSTREAM=https://replace-with-internal-s3-endpoint
GARAGE_S3_TLS_SERVER_NAME=replace-with-internal-s3-host
GARAGE_PUBLIC_WEB_UPSTREAM=https://replace-with-garage-website-endpoint
GARAGE_PUBLIC_WEB_TLS_SERVER_NAME=replace-with-garage-website-host

# Separate validation/transform worker lifecycle and resource budget.
VALIDATION_WORKER_CONCURRENCY=2
VALIDATION_WORKER_POLL_MS=5000
VALIDATION_WORKER_TEMP_ROOT=/tmp/pcu-validation
VALIDATION_WORKER_TEMP_DISK_BUDGET_BYTES=12884901888
VALIDATION_WORKER_CLAIM_LEASE_MS=600000

EXPORT_WORKER_CONCURRENCY=1
EXPORT_WORKER_POLL_MS=5000
EXPORT_WORKER_CLAIM_LEASE_MS=600000

# NAS export
NAS_EXPORT_HOST_PATH=/mnt/nas/pcu_storage/GraduationGame
NAS_EXPORT_PATH=/nas
