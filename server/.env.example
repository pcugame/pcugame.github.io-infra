# Copy to /srv/graduationproject_v2/.env on the server. Do not commit real values.

# Runtime binding used by server/deploy.sh
API_BIND_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
# The production API is reachable through exactly one loopback nginx proxy hop.
# Set this to false if the API is ever exposed directly without that proxy.
TRUST_PROXY=1

# PostgreSQL container and API DATABASE_URL
POSTGRES_DB=pcu_graduationproject_v2
POSTGRES_USER=pcu_admin
POSTGRES_PASSWORD=replace-with-production-postgres-password
DATABASE_URL=postgresql://pcu_admin:replace-with-production-postgres-password@postgres:5432/pcu_graduationproject_v2?schema=public

# Session cookie
SESSION_SECRET=replace-with-32-plus-character-production-session-secret
SESSION_COOKIE_NAME=sid
SESSION_IDLE_MS=7200000
SESSION_ABSOLUTE_MS=1209600000
SESSION_TOUCH_MIN_INTERVAL_MS=300000
SHUTDOWN_DRAIN_MS=15000
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# OAuth and public origins
GOOGLE_CLIENT_IDS=replace-with-google-web-client-id.apps.googleusercontent.com
ALLOWED_GOOGLE_HD=g.pcu.ac.kr
CORS_ALLOWED_ORIGINS=https://pcugame.github.io
API_PUBLIC_URL=https://replace-with-api-host
WEB_PUBLIC_URL=https://pcugame.github.io
PUBLIC_ASSET_ORIGIN=https://replace-with-public-object-host

# S3-compatible object storage
# Private cross-host Garage S3 endpoint. Firewall it to the API/worker server,
# use TLS, and never route Garage admin/management listeners or the raw NAS FS.
S3_ENDPOINT=https://garage-s3.private.example
# Browser-visible upload reverse proxy used only to sign UploadPart URLs.
S3_PUBLIC_SIGNING_ENDPOINT=https://replace-with-upload-host
S3_PRIVATE_NETWORK_CONFIRMED=false
# Optional private CA bundle. Leave empty when Garage uses a public CA.
S3_TLS_CA_HOST_PATH=
S3_REGION=garage
S3_ACCESS_KEY_ID=replace-with-s3-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
S3_BUCKET_PUBLIC=pcu-public
S3_BUCKET_PROTECTED=pcu-protected
S3_FORCE_PATH_STYLE=true

# Direct multipart capability/worker capacity. The refresh allowance is a
# session-lifetime replacement count, not an IP/window rate limit.
DIRECT_UPLOAD_PART_URL_REFRESH_MAX=64
UPLOAD_USER_GAME_MAX_MB=5120
UPLOAD_PRIVILEGED_GAME_MAX_MB=5120
DIRECT_UPLOAD_WORKER_TEMP_MAX_MB=6144

# Private NAS export: mounted only into the export worker, never API/public nginx.
NAS_EXPORT_HOST_PATH=/mnt/nas/pcu_storage/GraduationGame
NAS_EXPORT_PATH=/nas-export
EXPORT_WORKER_MAX_OBJECT_BYTES=5368709120
EXPORT_WORKER_MAX_JOB_BYTES=34359738368
# One complete export job may coexist with this operator-selected safety margin
# in the NAS staging filesystem.
NAS_EXPORT_STAGING_HEADROOM_BYTES=1073741824

# Immediately before each deployment, measure Garage data-volume free space on
# the NAS and replace 0. One WebGL deployment needs 15 GiB plus this headroom.
GARAGE_DEPLOYMENT_HEADROOM_BYTES=1073741824
GARAGE_CAPACITY_ATTESTED_AVAILABLE_BYTES=0
