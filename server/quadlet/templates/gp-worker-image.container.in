[Unit]
Description=Graduation project gp-worker-image
After=gp-api.service

[Container]
Image=@API_IMAGE@
ContainerName=gp-worker-image
Pod=graduationproject.pod
StartWithPod=true
EnvironmentFile=@COMMON_ENV@
Environment=NODE_ENV=production
@CA_ENV@
@CA_VOLUME@
Tmpfs=/tmp:rw,noexec,nosuid,size=512m
Entrypoint=node
Exec=dist/image-worker.js
StopTimeout=10

[Service]
Restart=always
