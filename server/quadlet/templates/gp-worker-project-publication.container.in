[Unit]
Description=Graduation project gp-worker-project-publication
After=gp-api.service

[Container]
Image=@API_IMAGE@
ContainerName=gp-worker-project-publication
Pod=graduationproject.pod
StartWithPod=true
EnvironmentFile=@COMMON_ENV@
Environment=NODE_ENV=production
@CA_ENV@
@CA_VOLUME@
Entrypoint=node
Exec=dist/project-publication-worker.js
StopTimeout=10

[Service]
Restart=always
