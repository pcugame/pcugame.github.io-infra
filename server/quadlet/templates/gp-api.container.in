[Unit]
Description=Graduation project gp-api
After=gp-postgres.service

[Container]
Image=@API_IMAGE@
ContainerName=gp-api
Pod=graduationproject.pod
StartWithPod=true
EnvironmentFile=@COMMON_ENV@
Environment=NODE_ENV=production
@CA_ENV@
@CA_VOLUME@
EnvironmentFile=@API_ENV@
Environment=PORT=4000
Entrypoint=node
Exec=dist/server.js
# Application total budget is capped at 60s; allow 5s for process exit.
StopTimeout=65

[Service]
# Allow Podman its full stop grace plus 10s of service teardown.
TimeoutStopSec=75
Restart=always
