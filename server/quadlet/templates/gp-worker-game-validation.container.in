[Unit]
Description=Graduation project gp-worker-game-validation
After=gp-api.service

[Container]
Image=@API_IMAGE@
ContainerName=gp-worker-game-validation
Pod=graduationproject.pod
StartWithPod=true
EnvironmentFile=@COMMON_ENV@
Environment=NODE_ENV=production
@CA_ENV@
@CA_VOLUME@
Tmpfs=/tmp:rw,noexec,nosuid,size=6g
Entrypoint=node
Exec=dist/game-validation-worker.js
StopTimeout=10

[Service]
Restart=always
