[Unit]
Description=Private SearXNG for nickname evidence

[Container]
Image=docker.io/searxng/searxng@sha256:5b72d7ef63a3d214c2a690016ecf53a17f1ab7f02dcc4a1de1669837d9340fc9
ContainerName=gp-lab-search
Pod=graduationproject.pod
StartWithPod=true
Environment=GRANIAN_HOST=127.0.0.1
Environment=GRANIAN_PORT=18888
EnvironmentFile=%h/.config/pcu-lab-search/search.env
Volume=%h/.config/pcu-lab-search/settings.yml:/etc/searxng/settings.yml:ro,Z

[Service]
Restart=on-failure
RestartSec=5
