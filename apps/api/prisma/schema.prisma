generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────

enum UserRole {
  USER
  OPERATOR
  ADMIN
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectSubmissionState {
  PENDING
  FINALIZING
  PUBLISHED
  CANCELLED
}

enum ProjectSubmissionItemState {
  EXPECTED
  UPLOADING
  VERIFYING
  READY
  FAILED
  CANCELLED
}

enum ProjectSubmissionPlaybackState {
  NONE
  READY
  FAILED
}

enum ProjectPublicationJobState {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum StorageVisibility {
  PROTECTED
  PUBLIC
}

enum AssetKind {
  DOCUMENT
  ATTACHMENT
  THUMBNAIL
  IMAGE
  POSTER
  GAME
  VIDEO
  WEBGL
}

enum AssetStatus {
  PENDING
  VERIFYING
  PROCESSING
  READY
  DELETING
  DELETED
  FAILED
}

enum AssetRepresentationRole {
  ORIGINAL
  PLAYBACK
  CARD_480
  DISPLAY_960
  WEBGL_SOURCE
}

enum AssetRepresentationState {
  PENDING
  VERIFYING
  READY
  FAILED
  DELETING
  DELETED
}

enum WebglDeploymentState {
  PENDING
  PROCESSING
  READY
  FAILED
  DELETING
  DELETED
}

enum Platform {
  PC
  MOBILE
  WEB
}

enum AssetUploadKind {
  DOCUMENT
  ATTACHMENT
  GAME
  WEBGL
  VIDEO
  IMAGE
  POSTER
}

enum AssetUploadSessionState {
  ALLOCATING
  UPLOADING
  COMPLETING
  VERIFYING
  READY
  REJECTED
  CANCELLED
  EXPIRED
}

enum OrphanTargetKind {
  EXACT
  PREFIX
}

enum OrphanState {
  PENDING
  DELETE_CLAIMED
  CANCELLED
  RESOLVED
}

enum UploadIntentState {
  PREPARED
  UPLOADED
  COMMITTED
  CLEANUP_QUEUED
  RESOLVED
}

enum IdempotencyOperationState {
  IN_PROGRESS
  SUCCEEDED
  RETRYABLE_FAILED
  TERMINAL_FAILED
}

enum MultipartAbortTaskState {
  PENDING
  CLAIMED
  RESOLVED
}

enum ExportJobState {
  QUEUED
  RUNNING
  READY
  FAILED
  CANCELLED
}

// ─── Models ───────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  googleSub String   @unique @map("google_sub")
  email     String   @default("")
  studentId String?  @unique @map("student_id")
  name      String   @default("")
  picture   String   @default("")
  role      UserRole @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions     AuthSession[]        @relation("UserSessions")
  projects     Project[]            @relation("ProjectCreator")
  memberships  ProjectMember[]      @relation("UserMemberships")
  assetUploads AssetUploadSession[] @relation("UserAssetUploads")
  exportJobs   ExportJob[]          @relation("UserExportJobs")
  submissions  ProjectSubmission[]  @relation("UserProjectSubmissions")

  @@map("users")
}

model Exhibition {
  id              Int      @id @default(autoincrement())
  year            Int
  title           String   @default("")
  isModificationEnabled Boolean  @default(true) @map("is_upload_enabled")
  sortOrder       Int      @default(0) @map("sort_order")
  posterAssetId   Int?     @unique @map("poster_asset_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  projects     Project[]            @relation("ExhibitionProjects")
  assets       Asset[]              @relation("ExhibitionAssets")
  poster       Asset?               @relation("ExhibitionPoster", fields: [posterAssetId], references: [id], onDelete: SetNull)
  assetUploads AssetUploadSession[] @relation("ExhibitionAssetUploads")

  @@unique([year, title], name: "year_title")
  @@index([sortOrder, year])
  @@map("exhibitions")
}

model Project {
  version                  Int           @default(1)
  id                       Int           @id @default(autoincrement())
  exhibitionId             Int           @map("exhibition_id")
  slug                     String
  title                    String
  summary                  String        @default("")
  description              String        @default("")
  isIncomplete             Boolean       @default(false) @map("is_incomplete")
  status                   ProjectStatus @default(DRAFT)
  sortOrder                Int           @default(0) @map("sort_order")
  githubUrl                String        @default("") @map("github_url")
  platforms                Platform[]    @default([])
  posterAssetId            Int?          @unique @map("poster_asset_id")
  currentWebglDeploymentId String?       @unique @map("current_webgl_deployment_id")
  creatorId                Int           @map("creator_id")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")

  exhibition             Exhibition       @relation("ExhibitionProjects", fields: [exhibitionId], references: [id], onDelete: Cascade)
  creator                User             @relation("ProjectCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  poster                 Asset?           @relation("ProjectPoster", fields: [posterAssetId], references: [id], onDelete: SetNull)
  currentWebglDeployment WebglDeployment? @relation("ProjectCurrentWebglDeployment", fields: [currentWebglDeploymentId], references: [id], onDelete: SetNull)

  members          ProjectMember[]        @relation("ProjectMembers")
  assets           Asset[]                @relation("ProjectAssets")
  webglDeployments WebglDeployment[]      @relation("ProjectWebglDeployments")
  assetUploads     AssetUploadSession[]   @relation("ProjectAssetUploads")
  submission       ProjectSubmission?
  publicationJob   ProjectPublicationJob?
  changeRequests ProjectChangeRequest[] @relation("ChangeRequestSource")
  changeRequestDraft ProjectChangeRequest? @relation("ChangeRequestStaging")

  @@unique([exhibitionId, slug], name: "project_exhibition_slug")
  @@index([exhibitionId, status, sortOrder])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  userId    Int?     @map("user_id")
  name      String
  studentId String   @default("") @map("student_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation("ProjectMembers", fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation("UserMemberships", fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, sortOrder])
  @@index([userId])
  @@map("project_members")
}

model Asset {
  id             Int         @id @default(autoincrement())
  projectId      Int?        @map("project_id")
  exhibitionId   Int?        @map("exhibition_id")
  kind           AssetKind
  status         AssetStatus @default(READY)
  videoSortOrder Int?        @map("video_sort_order")
  originalName   String      @default("") @map("original_name")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  project            Project?                @relation("ProjectAssets", fields: [projectId], references: [id], onDelete: Cascade)
  exhibition         Exhibition?             @relation("ExhibitionAssets", fields: [exhibitionId], references: [id], onDelete: Cascade)
  posterOf           Project?                @relation("ProjectPoster")
  posterOfExhibition Exhibition?             @relation("ExhibitionPoster")
  representations    AssetRepresentation[]   @relation("AssetRepresentations")
  expectedByUploads  AssetUploadSession[]    @relation("AssetUploadExpectedTarget")
  resultOfUploads    AssetUploadSession[]    @relation("AssetUploadResult")
  submissionItems    ProjectSubmissionItem[] @relation("ProjectSubmissionItemAsset")

  @@index([projectId, kind, status])
  @@index([exhibitionId, kind, status])
  // Partial unique index `asset_project_game_ready_unique` on (project_id, kind)
  // WHERE status = 'READY' AND kind = 'GAME' is applied via raw SQL in
  // `migrations/20260523_allow_multiple_videos/` — Prisma can't express partial-unique
  // in the DSL. VIDEO/IMAGE etc. are intentionally excluded (projects may hold many).
  @@map("assets")
}

/// Maps an environment-specific Garage bucket name to its canonical security
/// class. Release tooling seeds this registry from configuration; application
/// rows reference the registry instead of relying on bucket-name conventions.
model StorageBucket {
  bucket     String            @id
  visibility StorageVisibility @unique(map: "storage_buckets_visibility_key")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  representations            AssetRepresentation[] @relation("AssetRepresentationBucket")
  publicationRepresentations AssetRepresentation[] @relation("AssetRepresentationPublicationBucket")
  publicWebglDeployments     WebglDeployment[]     @relation("WebglDeploymentPublicBucket")
  stagingWebglDeployments    WebglDeployment[]     @relation("WebglDeploymentStagingBucket")

  @@index([visibility], map: "storage_buckets_visibility_idx")
  @@map("storage_buckets")
}

model AssetRepresentation {
  id                      String                   @id @default(uuid())
  assetId                 Int                      @map("asset_id")
  role                    AssetRepresentationRole
  bucket                  String
  objectKey               String                   @map("object_key")
  publicationBucket       String?                  @map("publication_bucket")
  publicationObjectKey    String?                  @map("publication_object_key")
  mimeType                String                   @default("") @map("mime_type")
  sizeBytes               BigInt                   @default(0) @map("size_bytes")
  checksumAlgorithm       String?                  @map("checksum_algorithm")
  checksum                String?
  etag                    String?
  sourceIdentityAlgorithm String?                  @map("source_identity_algorithm")
  sourceIdentity          String?                  @map("source_identity")
  state                   AssetRepresentationState @default(PENDING)
  error                   String?
  width                   Int?
  height                  Int?
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  asset                    Asset                   @relation("AssetRepresentations", fields: [assetId], references: [id], onDelete: Cascade)
  storageBucket            StorageBucket           @relation("AssetRepresentationBucket", fields: [bucket], references: [bucket], onDelete: Restrict, onUpdate: Cascade)
  publicationStorageBucket StorageBucket?          @relation("AssetRepresentationPublicationBucket", fields: [publicationBucket], references: [bucket], onDelete: Restrict, onUpdate: Cascade)
  webglDeployments         WebglDeployment[]       @relation("WebglDeploymentSourceRepresentation")
  resultOfUploads          AssetUploadSession[]    @relation("AssetUploadResultRepresentation")
  submissionItems          ProjectSubmissionItem[] @relation("ProjectSubmissionItemRepresentation")

  @@unique([assetId, role], name: "asset_representation_asset_role", map: "asset_representations_asset_id_role_key")
  @@unique([publicationBucket, publicationObjectKey], name: "asset_representation_publication_target", map: "asset_representations_publication_target_key")
  @@index([bucket, objectKey], map: "asset_representations_bucket_object_key_idx")
  @@index([state], map: "asset_representations_state_idx")
  @@index([sourceIdentityAlgorithm, sourceIdentity], map: "asset_representations_source_identity_idx")
  @@map("asset_representations")
}

model WebglDeployment {
  id                     String               @id @default(uuid())
  projectId              Int                  @map("project_id")
  sourceRepresentationId String               @map("source_representation_id")
  publicBucket           String               @map("public_bucket")
  publicPrefix           String               @map("public_prefix")
  entryObjectKey         String               @map("entry_object_key")
  objectManifest         Json?                @map("object_manifest")
  stagingBucket          String?              @map("staging_bucket")
  stagingPrefix          String?              @map("staging_prefix")
  stagingEntryObjectKey  String?              @map("staging_entry_object_key")
  stagingObjectManifest  Json?                @map("staging_object_manifest")
  state                  WebglDeploymentState @default(PENDING)
  error                  String?
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  project              Project                 @relation("ProjectWebglDeployments", fields: [projectId], references: [id], onDelete: Cascade)
  publicStorageBucket  StorageBucket           @relation("WebglDeploymentPublicBucket", fields: [publicBucket], references: [bucket], onDelete: Restrict, onUpdate: Cascade)
  stagingStorageBucket StorageBucket?          @relation("WebglDeploymentStagingBucket", fields: [stagingBucket], references: [bucket], onDelete: Restrict, onUpdate: Cascade)
  sourceRepresentation AssetRepresentation     @relation("WebglDeploymentSourceRepresentation", fields: [sourceRepresentationId], references: [id], onDelete: Cascade)
  currentForProject    Project?                @relation("ProjectCurrentWebglDeployment")
  reservedForUpload    AssetUploadSession?     @relation("AssetUploadReservedWebglDeployment")
  submissionItems      ProjectSubmissionItem[] @relation("ProjectSubmissionItemWebglDeployment")

  @@unique([publicBucket, publicPrefix], name: "webgl_deployment_public_namespace", map: "webgl_deployments_public_bucket_prefix_key")
  @@index([projectId, state], map: "webgl_deployments_project_id_state_idx")
  @@index([sourceRepresentationId], map: "webgl_deployments_source_representation_id_idx")
  @@map("webgl_deployments")
}

/// Canonical direct-to-Garage multipart session for all bulk asset kinds.
/// Garage ListParts is authoritative; no part/chunk rows are persisted here.
model AssetUploadSession {
  id                           String                  @id @default(uuid())
  projectId                    Int?                    @map("project_id")
  exhibitionId                 Int?                    @map("exhibition_id")
  userId                       Int                     @map("user_id")
  kind                         AssetUploadKind
  state                        AssetUploadSessionState @default(ALLOCATING)
  originalName                 String                  @map("original_name")
  declaredMimeType             String                  @default("") @map("declared_mime_type")
  totalBytes                   BigInt                  @map("total_bytes")
  partSizeBytes                Int                     @map("part_size_bytes")
  totalParts                   Int                     @map("total_parts")
  bucket                       String
  objectKey                    String                  @map("object_key")
  uploadId                     String?                 @map("upload_id")
  generation                   Int                     @default(1)
  // This is a session-lifetime capability budget: the first `totalParts`
  // issues cover one URL per physical part, with only the configured refresh
  // allowance available afterwards. It deliberately never uses a rolling
  // time window.
  partCapabilityIssuedCount    Int                     @default(0) @map("part_capability_issued_count")
  partCapabilityFirstIssuedAt  DateTime?               @map("part_capability_first_issued_at")
  partCapabilityLastIssuedAt   DateTime?               @map("part_capability_last_issued_at")
  sourceIdentityAlgorithm      String                  @map("source_identity_algorithm")
  sourceIdentity               String                  @map("source_identity")
  sourceIdentityBlockSizeBytes Int                     @map("source_identity_block_size_bytes")
  sourceIdentityBlockManifest  Json                    @map("source_identity_block_manifest")
  completionLeaseToken         String?                 @map("completion_lease_token")
  completionLeaseUntil         DateTime?               @map("completion_lease_until")
  completionError              String?                 @map("completion_error")
  completionResult             Json?                   @map("completion_result")
  validationLeaseToken         String?                 @map("validation_lease_token")
  validationLeaseUntil         DateTime?               @map("validation_lease_until")
  validationError              String?                 @map("validation_error")
  validationAttemptCount       Int                     @default(0) @map("validation_attempt_count")
  expectedTargetAssetId        Int?                    @map("expected_target_asset_id")
  expectedTargetAssetUpdatedAt DateTime?               @map("expected_target_asset_updated_at")
  resultAssetId                Int?                    @unique @map("result_asset_id")
  resultRepresentationId       String?                 @unique @map("result_representation_id")
  reservedWebglDeploymentId    String?                 @unique @map("reserved_webgl_deployment_id")
  submissionItemId             String?                 @unique @map("submission_item_id")
  expiresAt                    DateTime                @map("expires_at")
  completedAt                  DateTime?               @map("completed_at")
  createdAt                    DateTime                @default(now()) @map("created_at")
  updatedAt                    DateTime                @updatedAt @map("updated_at")

  project                 Project?               @relation("ProjectAssetUploads", fields: [projectId], references: [id], onDelete: Restrict)
  exhibition              Exhibition?            @relation("ExhibitionAssetUploads", fields: [exhibitionId], references: [id], onDelete: Restrict)
  user                    User                   @relation("UserAssetUploads", fields: [userId], references: [id], onDelete: Restrict)
  expectedTargetAsset     Asset?                 @relation("AssetUploadExpectedTarget", fields: [expectedTargetAssetId], references: [id], onDelete: SetNull)
  resultAsset             Asset?                 @relation("AssetUploadResult", fields: [resultAssetId], references: [id], onDelete: SetNull)
  resultRepresentation    AssetRepresentation?   @relation("AssetUploadResultRepresentation", fields: [resultRepresentationId], references: [id], onDelete: SetNull)
  reservedWebglDeployment WebglDeployment?       @relation("AssetUploadReservedWebglDeployment", fields: [reservedWebglDeploymentId], references: [id], onDelete: SetNull)
  submissionItem          ProjectSubmissionItem? @relation("ProjectSubmissionItemUpload", fields: [submissionItemId], references: [id], onDelete: SetNull)
  abortTasks              MultipartAbortTask[]   @relation("AssetUploadAbortTasks")

  // Partial unique index `asset_upload_sessions_active_project_kind_key` keeps
  // non-VIDEO project uploads single-active. VIDEO sessions reserve one of five
  // project slots and are intentionally excluded by the video-order expand SQL.
  @@index([projectId, kind, state], map: "asset_upload_sessions_project_kind_state_idx")
  @@index([exhibitionId, kind, state], map: "asset_upload_sessions_exhibition_kind_state_idx")
  @@index([userId, state], map: "asset_upload_sessions_user_state_idx")
  @@index([state, expiresAt], map: "asset_upload_sessions_state_expires_at_idx")
  @@index([state, completionLeaseUntil], map: "asset_upload_sessions_completion_recovery_idx")
  @@index([state, validationLeaseUntil], map: "asset_upload_sessions_validation_recovery_idx")
  @@index([bucket, objectKey], map: "asset_upload_sessions_bucket_object_key_idx")
  @@index([expectedTargetAssetId, expectedTargetAssetUpdatedAt], map: "asset_upload_sessions_expected_target_fence_idx")
  @@map("asset_upload_sessions")
}

/// Durable aggregate guarding first publication until every selected direct
/// upload has reached a canonical READY result.
model ProjectSubmission {
  id          String                 @id @default(uuid())
  projectId   Int                    @unique @map("project_id")
  actorId     Int                    @map("actor_id")
  state       ProjectSubmissionState @default(PENDING)
  publishedAt DateTime?              @map("published_at")
  cancelledAt DateTime?              @map("cancelled_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor          User                    @relation("UserProjectSubmissions", fields: [actorId], references: [id], onDelete: Restrict)
  items          ProjectSubmissionItem[]
  publicationJob ProjectPublicationJob?

  @@unique([id, projectId], name: "project_submission_identity", map: "project_submissions_id_project_id_key")
  @@index([actorId, state], map: "project_submissions_actor_state_idx")
  @@index([state, updatedAt], map: "project_submissions_state_updated_at_idx")
  @@map("project_submissions")
}

/// One unforgeable upload slot from the metadata-time manifest. A slot may
/// bind exactly one generation-fenced direct multipart session.
model ProjectSubmissionItem {
  id                      String                         @id @default(uuid())
  submissionId            String                         @map("submission_id")
  kind                    AssetUploadKind
  slot                    String
  clientToken             String                         @map("client_token")
  required                Boolean                        @default(true)
  state                   ProjectSubmissionItemState     @default(EXPECTED)
  boundGeneration         Int?                           @map("bound_generation")
  resultAssetId           Int?                           @map("result_asset_id")
  resultRepresentationId  String?                        @map("result_representation_id")
  resultWebglDeploymentId String?                        @map("result_webgl_deployment_id")
  failureReason           String?                        @map("failure_reason")
  playbackState           ProjectSubmissionPlaybackState @default(NONE) @map("playback_state")
  playbackError           String?                        @map("playback_error")
  createdAt               DateTime                       @default(now()) @map("created_at")
  updatedAt               DateTime                       @updatedAt @map("updated_at")

  projectSubmission     ProjectSubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploadSession         AssetUploadSession?  @relation("ProjectSubmissionItemUpload")
  resultAsset           Asset?               @relation("ProjectSubmissionItemAsset", fields: [resultAssetId], references: [id], onDelete: SetNull)
  resultRepresentation  AssetRepresentation? @relation("ProjectSubmissionItemRepresentation", fields: [resultRepresentationId], references: [id], onDelete: SetNull)
  resultWebglDeployment WebglDeployment?     @relation("ProjectSubmissionItemWebglDeployment", fields: [resultWebglDeploymentId], references: [id], onDelete: SetNull)

  @@unique([submissionId, slot], name: "project_submission_item_slot", map: "project_submission_items_submission_id_slot_key")
  @@unique([submissionId, clientToken], name: "project_submission_item_client_token", map: "project_submission_items_submission_id_client_token_key")
  @@index([submissionId, state], map: "project_submission_items_submission_state_idx")
  @@index([resultAssetId], map: "project_submission_items_result_asset_idx")
  @@index([resultRepresentationId], map: "project_submission_items_result_representation_idx")
  @@index([resultWebglDeploymentId], map: "project_submission_items_result_webgl_idx")
  @@map("project_submission_items")
}

/// Durable worker-owned publication request. Its immutable plan lets retries
/// verify already-copied objects and lets cancellation clean late copies.
model ProjectPublicationJob {
  id           String                     @id @default(uuid())
  projectId    Int                        @unique @map("project_id")
  submissionId String                     @unique @map("submission_id")
  state        ProjectPublicationJobState @default(PENDING)
  plan         Json
  claimToken   String?                    @map("claim_token")
  claimUntil   DateTime?                  @map("claim_until")
  attemptCount Int                        @default(0) @map("attempt_count")
  lastError    String?                    @map("last_error")
  completedAt  DateTime?                  @map("completed_at")
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submission ProjectSubmission @relation(fields: [submissionId, projectId], references: [id, projectId], onDelete: Cascade)

  @@unique([submissionId, projectId], name: "project_publication_job_submission_identity", map: "project_publication_jobs_submission_id_project_id_key")
  @@index([state, claimUntil, createdAt], map: "project_publication_jobs_claim_idx")
  @@map("project_publication_jobs")
}

/// Durable control-plane request consumed only by the export processing role.
model ExportJob {
  id            String         @id @default(uuid())
  requestedById Int            @map("requested_by_id")
  year          Int?
  dryRun        Boolean        @default(false) @map("dry_run")
  state         ExportJobState @default(QUEUED)
  snapshot      Json?
  snapshotHash  String?        @map("snapshot_hash")
  progress      Json?
  result        Json?
  error         String?
  claimToken    String?        @map("claim_token")
  claimUntil    DateTime?      @map("claim_until")
  attemptCount  Int            @default(0) @map("attempt_count")
  maxAttempts   Int            @default(5) @map("max_attempts")
  nextAttemptAt DateTime       @default(now()) @map("next_attempt_at")
  startedAt     DateTime?      @map("started_at")
  finishedAt    DateTime?      @map("finished_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  requestedBy User @relation("UserExportJobs", fields: [requestedById], references: [id], onDelete: Restrict)

  // Partial unique index `export_jobs_single_active_idx` is installed by SQL.
  @@index([state, nextAttemptAt, createdAt], map: "export_jobs_claim_idx")
  @@index([claimUntil], map: "export_jobs_claim_until_idx")
  @@index([requestedById, createdAt], map: "export_jobs_requested_by_created_at_idx")
  @@map("export_jobs")
}

model AuthSession {
  id         String   @id @default(uuid())
  userId     Int      @map("user_id")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// IP addresses permanently banned from downloading protected assets.
/// Auto-banned when download rate limit is exceeded; admins can unban.
model BannedIp {
  id        Int      @id @default(autoincrement())
  ip        String   @unique
  reason    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("banned_ips")
}

/// S3 objects that outlived their DB record — queued by `safeDeleteObject`
/// when a sync S3 delete fails, and periodically retried by the orphan reaper.
/// A row is "pending" while resolvedAt is null; resolved rows are kept for audit.
model OrphanObject {
  id            Int              @id @default(autoincrement())
  bucket        String
  storageKey    String           @map("storage_key")
  reason        String           @default("")
  targetKind    OrphanTargetKind @default(EXACT) @map("target_kind")
  state         OrphanState      @default(PENDING)
  claimToken    String?          @map("claim_token")
  claimUntil    DateTime?        @map("claim_until")
  cancelReason  String?          @map("cancel_reason")
  nextAttemptAt DateTime         @default(now()) @map("next_attempt_at")
  attemptCount  Int              @default(0) @map("attempt_count")
  lastTriedAt   DateTime?        @map("last_tried_at")
  lastError     String?          @map("last_error")
  resolvedAt    DateTime?        @map("resolved_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@unique([bucket, storageKey], name: "orphan_bucket_storage_key", map: "orphan_bucket_storage_key")
  @@index([state, nextAttemptAt])
  @@index([claimUntil])
  @@map("orphan_objects")
}

model UploadIntent {
  id                String            @id @default(uuid())
  bucket            String
  storageKey        String            @map("storage_key")
  purpose           String
  ownerOperationId  String?           @map("owner_operation_id")
  ownerActorId      Int?              @map("owner_actor_id")
  ownerProjectId    Int?              @map("owner_project_id")
  ownerExhibitionId Int?              @map("owner_exhibition_id")
  state             UploadIntentState @default(PREPARED)
  notBefore         DateTime          @map("not_before")
  attemptCount      Int               @default(0) @map("attempt_count")
  nextAttemptAt     DateTime          @default(now()) @map("next_attempt_at")
  lastError         String?           @map("last_error")
  claimToken        String?           @map("claim_token")
  claimUntil        DateTime?         @map("claim_until")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@unique([bucket, storageKey], name: "upload_intent_bucket_storage_key", map: "upload_intent_bucket_storage_key")
  @@index([state, nextAttemptAt, notBefore])
  @@index([ownerOperationId])
  @@map("upload_intents")
}

model IdempotencyOperation {
  id          String                    @id @default(uuid())
  actorId     Int                       @map("actor_id")
  scope       String
  key         String
  requestHash String                    @map("request_hash")
  state       IdempotencyOperationState @default(IN_PROGRESS)
  ownerToken  String?                   @map("owner_token")
  ownerUntil  DateTime?                 @map("owner_until")
  result      Json?
  lastError   String?                   @map("last_error")
  expiresAt   DateTime                  @map("expires_at")
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")

  @@unique([actorId, scope, key], name: "idempotency_actor_scope_key", map: "idempotency_actor_scope_key")
  @@index([state, ownerUntil])
  @@index([expiresAt])
  @@map("idempotency_operations")
}

model MultipartAbortTask {
  id            String                  @id @default(uuid())
  bucket        String
  storageKey    String                  @map("storage_key")
  uploadId      String                  @map("upload_id")
  reason        String                  @default("")
  state         MultipartAbortTaskState @default(PENDING)
  attemptCount  Int                     @default(0) @map("attempt_count")
  nextAttemptAt DateTime                @default(now()) @map("next_attempt_at")
  lastError     String?                 @map("last_error")
  claimToken    String?                 @map("claim_token")
  claimUntil    DateTime?               @map("claim_until")
  resolvedAt    DateTime?               @map("resolved_at")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  uploadSessionId String?             @map("upload_session_id")
  uploadSession   AssetUploadSession? @relation("AssetUploadAbortTasks", fields: [uploadSessionId], references: [id], onDelete: SetNull)

  @@unique([bucket, storageKey, uploadId], name: "multipart_abort_bucket_key_upload", map: "multipart_abort_bucket_key_upload")
  @@index([state, nextAttemptAt])
  @@index([claimUntil])
  @@index([uploadSessionId])
  @@map("multipart_abort_tasks")
}

/// Runtime-configurable site settings (single row, id = "default").
/// Read from memory cache; updated via admin API without server restart.
model SiteSetting {
  id             String   @id @default("default")
  maxGameFileMb  Int      @default(5120) @map("max_game_file_mb")
  maxChunkSizeMb Int      @default(10) @map("max_chunk_size_mb")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// Change requests retain their snapshots after permanent project deletion.
enum ProjectChangeKind {
  EDIT
  DELETE
}
enum ProjectChangeState {
  DRAFT
  PENDING
  APPLYING
  COMPLETED
  REJECTED
  CANCELLED
  CONFLICT
  FAILED
}
model ProjectChangeRequest {
  id String @id @default(uuid())
  projectId Int? @map("project_id")
  originalProjectId Int @map("original_project_id")
  projectTitle String @map("project_title")
  actorId Int @map("actor_id")
  kind ProjectChangeKind
  state ProjectChangeState @default(DRAFT)
  baseVersion Int @map("base_version")
  before Json
  changes Json
  reason String
  reviewReason String? @map("review_reason")
  reviewerId Int? @map("reviewer_id")
  error String?
  fileSnapshot Json @default("[]") @map("file_snapshot")
  stagingProjectId Int? @unique @map("staging_project_id")
  submittedAt DateTime? @map("submitted_at")
  reviewedAt DateTime? @map("reviewed_at")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project Project? @relation("ChangeRequestSource", fields: [projectId], references: [id], onDelete: SetNull)
  stagingProject Project? @relation("ChangeRequestStaging", fields: [stagingProjectId], references: [id], onDelete: SetNull)
  @@index([state, createdAt])
  @@index([actorId, createdAt])
  @@index([originalProjectId, createdAt])
  @@map("project_change_requests")
}
