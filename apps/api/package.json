{
  "name": "@pcu-graduationproject-v2/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../.. run build -w @pcu/contracts",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm --prefix ../.. run build -w @pcu/contracts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.release.json",
    "start": "node dist/server.js",
    "worker:game-validation": "tsx src/game-validation-worker.ts",
    "worker:webgl": "tsx src/webgl-worker.ts",
    "worker:video": "tsx src/video-worker.ts",
    "worker:image": "tsx src/image-worker.ts",
    "worker:export": "tsx src/export-worker.ts",
    "worker:project-publication": "tsx src/project-publication-worker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:import": "tsx prisma/seed.ts --import ../db/legacy-import.json",
    "backfill:canonical-assets": "tsx scripts/backfill-canonical-assets.ts",
    "preflight:canonical-contract": "tsx scripts/preflight-canonical-contract.ts",
    "release:backfill": "node dist-release/scripts/backfill-canonical-assets.js",
    "release:preflight": "node dist-release/scripts/preflight-canonical-contract.js",
    "release:inventory": "node dist-release/scripts/snapshot-garage-inventory.js",
    "release:migrate": "node dist-release/scripts/release-migrate.js",
    "lint": "eslint src prisma scripts --max-warnings=0 && tsc --noEmit",
    "architecture:guard": "node scripts/architecture-guard.mjs src scripts",
    "architecture:self-test": "node scripts/architecture-self-test.mjs",
    "architecture": "npm run architecture:guard && npm run architecture:self-test && depcruise --config .dependency-cruiser.cjs src scripts",
    "pretest": "npm --prefix ../.. run build -w @pcu/contracts",
    "test": "vitest run && npm run test:scripts",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "correction:canonical-assets": "tsx scripts/correct-canonical-assets.ts",
    "release:correction": "node dist-release/scripts/correct-canonical-assets.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "@aws-sdk/s3-request-presigner": "^3.1024.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/type-provider-zod": "1.0.0",
    "@pcu/contracts": "*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@smithy/node-http-handler": "^4.6.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "file-type": "22.0.2",
    "google-auth-library": "^10.6.2",
    "pdf-to-img": "^6.2.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "sharp": "0.35.3",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/http-cache-semantics": "^4.2.0",
    "@types/node": "^22.10.2",
    "@types/sharp": "^0.31.1",
    "@types/yauzl": "^3.4.0",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.7.0",
    "http-cache-semantics": "^4.2.0",
    "prisma": "7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.1.0"
  }
}
