# UploadPart data-plane boundary. Query strings are deliberately absent from
# access logs because they contain short-lived SigV4 capabilities.
log_format pcu_upload_part
  'method=$request_method uri=$uri status=$status bytes_in=$request_length bytes_out=$bytes_sent';

limit_conn_zone $binary_remote_addr zone=pcu_upload_per_ip:10m;
limit_conn_zone $server_addr zone=pcu_upload_global:10m;

server {
  listen ${NGINX_LISTEN_PORT};
  server_name _;

  access_log /var/log/nginx/access.log pcu_upload_part;
  error_log /var/log/nginx/error.log warn;
  limit_conn pcu_upload_global ${UPLOAD_PART_GLOBAL_CONNECTIONS};
  limit_conn pcu_upload_per_ip ${UPLOAD_PART_PER_IP_CONNECTIONS};
  limit_conn_status 429;

  client_max_body_size ${UPLOAD_PART_MAX_BYTES};
  client_body_buffer_size 128k;
  client_body_temp_path /var/cache/nginx/client_temp 1 2;
  client_body_timeout 60s;
  send_timeout 60s;

  # Upload responses, including rejected bodies and upstream failure, must
  # never become a capability cache.
  add_header Cache-Control "no-store" always;
  add_header X-Content-Type-Options "nosniff" always;

  location = /__pcu_upload_health {
    access_log off;
    return 204;
  }

  # Do not turn an accidentally exposed upload origin into an admin or generic
  # S3 proxy. OPTIONS must reach Garage so its exact bucket CORS policy answers
  # signed/checksum UploadPart preflights. Garage performs the actual signature,
  # expiry, bucket and object authorization checks for PUT.
  location / {
    if ($request_method !~ ^(PUT|OPTIONS)$) { return 405; }

    # No URI component is used: preserve the exact escaped path and signed
    # query. The Host is likewise part of the browser-visible SigV4 request.
    proxy_pass ${GARAGE_S3_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Connection "";
    proxy_ssl_server_name on;
    proxy_ssl_name ${GARAGE_S3_TLS_SERVER_NAME};
    # Stream the bounded part instead of spooling it to NAS/temp disk. Invalid
    # signatures and slow clients are contained by the global connection cap;
    # a Garage restart fails the part and the browser safely retries that part.
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    proxy_next_upstream off;
  }
}
