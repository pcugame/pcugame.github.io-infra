FROM dxflrs/garage:v2.5.0@sha256:677e5b758e4425a325b811c425c026bf35a4bf42f7ddbaa773de3f4fd779a5a5 AS garage

FROM alpine:3.20
RUN apk add --no-cache aws-cli python3
COPY --from=garage /garage /usr/local/bin/garage
COPY garage-configure-cors.sh /usr/local/bin/garage-configure-cors
RUN chmod 0755 /usr/local/bin/garage-configure-cors
